generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(uuid())
  passwordHash String
  displayName  String
  realName     String
  furigana     String
  isStudent    Boolean  @default(true)
  status       String   @default("active") // active | withdrawal_requested | disabled
  createdAt    DateTime @default(now())
  affiliations UserAffiliation[]
  adminRole    AdminRole?
  posts        Post[]
  reports      Report[]
  @@map("users")
}
model AcademicYear {
  id        String   @id @default(uuid())
  year      Int      @unique
  isCurrent Boolean  @default(false)
  affiliations UserAffiliation[]
  @@map("academic_years")
}
model Grade {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)
  classes      Class[]
  affiliations UserAffiliation[]
  @@map("grades")
}
model Class {
  id       String  @id @default(uuid())
  gradeId  String
  name     String
  isActive Boolean @default(true)
  grade        Grade             @relation(fields: [gradeId], references: [id])
  affiliations UserAffiliation[]
  @@map("classes")
}
model UserAffiliation {
  id               String    @id @default(uuid())
  userId           String
  academicYearId   String
  gradeId          String
  classId          String
  attendanceNumber Int
  isCurrent        Boolean   @default(true)
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  user         User         @relation(fields: [userId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grade        Grade        @relation(fields: [gradeId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  @@map("user_affiliations")
  @@index([academicYearId, gradeId, attendanceNumber])
}
model AdminRole {
  id        String    @id @default(uuid())
  userId    String    @unique
  role      String // admin | sub_admin
  grantedBy String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id])
  @@map("admin_roles")
}
model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  actionType String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
  @@map("admin_actions")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  posts Post[]

  @@map("categories")
}

model Post {
  id       String  @id @default(uuid())
  authorId String
  title    String
  body     String

  categoryId String

  // 投稿時点の所属情報のスナップショット。
  // クラス変更・進級があっても過去の投稿の表示が変わらないよう、
  // user_affiliations を参照せず値をそのままコピーして保持する（計画書セクション8, 11）。
  authorGradeId   String
  authorClassId   String
  authorGradeName String
  authorClassName String

  deadline  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 論理削除。物理削除は2ヶ月経過後のバッチ処理で行う（計画書セクション14）。
  deletedAt DateTime?
  deletedBy String?

  author      User         @relation(fields: [authorId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  attachments Attachment[]
  reports     Report[]

  @@map("posts")
  @@index([authorGradeId, authorClassId, createdAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model Attachment {
  id          String   @id @default(uuid())
  postId      String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])

  @@map("attachments")
  @@index([postId])
}

model Report {
  id         String    @id @default(uuid())
  postId     String
  reporterId String
  reason     String // inappropriate | misinformation | personal_info | spam | other
  detail     String?
  status     String    @default("pending") // pending | resolved | dismissed
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  post     Post @relation(fields: [postId], references: [id])
  reporter User @relation(fields: [reporterId], references: [id])

  @@map("reports")
  @@index([status])
  @@index([postId])
}
