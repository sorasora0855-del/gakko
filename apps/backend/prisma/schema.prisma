generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  passwordHash String
  displayName  String
  realName     String
  furigana     String
  isStudent    Boolean  @default(true)
  status       String   @default("active") // active | withdrawal_requested | disabled
  createdAt    DateTime @default(now())

  affiliations UserAffiliation[]
  adminRole    AdminRole?

  @@map("users")
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      Int      @unique
  isCurrent Boolean  @default(false)

  affiliations UserAffiliation[]

  @@map("academic_years")
}

model Grade {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  classes      Class[]
  affiliations UserAffiliation[]

  @@map("grades")
}

model Class {
  id       String  @id @default(uuid())
  gradeId  String
  name     String
  isActive Boolean @default(true)

  grade        Grade             @relation(fields: [gradeId], references: [id])
  affiliations UserAffiliation[]

  @@map("classes")
}

model UserAffiliation {
  id               String    @id @default(uuid())
  userId           String
  academicYearId   String
  gradeId          String
  classId          String
  attendanceNumber Int
  isCurrent        Boolean   @default(true)
  validFrom        DateTime  @default(now())
  validTo          DateTime?

  user         User         @relation(fields: [userId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grade        Grade        @relation(fields: [gradeId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  @@map("user_affiliations")
  @@index([academicYearId, gradeId, attendanceNumber])
}

model AdminRole {
  id        String    @id @default(uuid())
  userId    String    @unique
  role      String // admin | sub_admin
  grantedBy String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("admin_roles")
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  actionType String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())

  @@map("admin_actions")
}
