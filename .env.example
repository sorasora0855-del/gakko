# Database
DATABASE_URL=postgresql://user:password@postgres:5432/schoollink

# Redis
REDIS_URL=redis://redis:6379

# Session
SESSION_COOKIE_NAME=sl_session
SESSION_TTL_SECONDS=604800

# Argon2id (benchmark on production-equivalent hardware before fixing values)
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=

# File Storage
FILE_STORAGE_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=10

# Rate Limit (requests per window, per endpoint group)
RATE_LIMIT_LOGIN=
RATE_LIMIT_REGISTER=
RATE_LIMIT_POST=
RATE_LIMIT_REPORT=
RATE_LIMIT_AI_QUERY=
RATE_LIMIT_UPLOAD=
RATE_LIMIT_PASSWORD_RESET=

# App
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
