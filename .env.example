# Database
# PostgreSQL接続文字列 (pgvector拡張を有効にしたインスタンス)
DATABASE_URL=postgresql://user:password@postgres:5432/schoollink

# Redis
# セッション管理・レート制限に使用
REDIS_URL=redis://redis:6379

# Session
# セッションCookie名
SESSION_COOKIE_NAME=sl_session
# セッション有効期限(秒)
SESSION_TTL_SECONDS=604800

# Argon2id
# 本番サーバーでベンチマーク(apps/backend/scripts/benchmark-argon2.ts)を実施し、
# ログイン処理が実用的な速度(目安200〜300ms、本サーバーでは139.5ms実測)に収まる値を設定する。
# 参考値(2026/09/04 本番サーバーで実測・採用): memoryCost=32768(32MB) timeCost=3 parallelism=2
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=

# Gemini API
# サーバー側からのみ呼び出す。ブラウザに公開しない。
GEMINI_API_KEY=
GEMINI_MODEL=

# File Storage
# 添付ファイル(JPG/PNG/WEBP/PDF)の保存先パス
FILE_STORAGE_PATH=/data/uploads
# アップロード上限サイズ(MB)
MAX_UPLOAD_SIZE_MB=10

# Rate Limit
# 各エンドポイント群ごとのリクエスト上限(具体的な単位・実装はbackend側のミドルウェアで定義)
RATE_LIMIT_LOGIN=
RATE_LIMIT_REGISTER=
RATE_LIMIT_POST=
RATE_LIMIT_REPORT=
RATE_LIMIT_AI_QUERY=
RATE_LIMIT_UPLOAD=
RATE_LIMIT_PASSWORD_RESET=

# App
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Docker Resource Limits (このサーバーはメモリ2.8GBのため、docker-compose側で各コンテナに上限を設定する。
# 値そのものはdocker-compose.ymlに記載し、ここでは参照用の記録のみ)
# postgres: 1024MB / redis: 128MB / backend: 256MB / web: 512MB を目安とする
